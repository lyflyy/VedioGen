{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vediogen.local/schemas/creative-brief/1.0.0",
  "title": "Creative Brief",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "projectId",
    "contentPack",
    "sourceProposalKeys",
    "targetPlatform",
    "locale",
    "audience",
    "primaryGoal",
    "contentType",
    "hook",
    "corePromise",
    "visualLanguage",
    "pacing",
    "emotionalPeak",
    "close",
    "mustKeep",
    "mustNotInvent",
    "output",
    "resourceEstimate"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "projectId": { "type": "string", "format": "uuid" },
    "contentPack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 100 },
        "version": { "type": "string", "minLength": 1, "maxLength": 50 }
      }
    },
    "parentBriefVersionId": { "type": ["string", "null"], "format": "uuid" },
    "sourceProposalKeys": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" }
    },
    "targetPlatform": { "enum": ["douyin", "other"] },
    "locale": { "type": "string", "pattern": "^[a-z]{2,3}(-[A-Z]{2})?$" },
    "audience": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": { "type": "string", "minLength": 1, "maxLength": 100 }
    },
    "primaryGoal": { "type": "string", "minLength": 1, "maxLength": 120 },
    "contentType": { "type": "string", "minLength": 1, "maxLength": 80 },
    "hook": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "visual", "durationMs"],
      "properties": {
        "text": { "type": "string", "minLength": 1, "maxLength": 120 },
        "visual": { "type": "string", "minLength": 1, "maxLength": 300 },
        "durationMs": { "type": "integer", "minimum": 500, "maximum": 3000 }
      }
    },
    "corePromise": { "type": "string", "minLength": 1, "maxLength": 240 },
    "visualLanguage": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": { "type": "string", "minLength": 1, "maxLength": 120 }
    },
    "tone": {
      "type": "array",
      "maxItems": 5,
      "items": { "type": "string", "minLength": 1, "maxLength": 60 }
    },
    "pacing": { "type": "string", "minLength": 1, "maxLength": 300 },
    "emotionalPeak": { "type": "string", "minLength": 1, "maxLength": 240 },
    "close": { "type": "string", "minLength": 1, "maxLength": 180 },
    "mustKeep": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 240 }
    },
    "mustNotInvent": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 240 }
    },
    "assetPlan": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["purpose", "preferredSource", "required"],
        "properties": {
          "purpose": { "type": "string", "minLength": 1, "maxLength": 160 },
          "preferredSource": { "enum": ["user", "generated", "blender", "stock", "either"] },
          "required": { "type": "boolean" }
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["aspectRatio", "width", "height", "frameRate", "durationMs", "subtitleMode"],
      "properties": {
        "aspectRatio": { "const": "9:16" },
        "width": { "type": "integer", "minimum": 360 },
        "height": { "type": "integer", "minimum": 640 },
        "frameRate": { "type": "number", "enum": [24, 25, 30, 50, 60] },
        "durationMs": { "type": "integer", "minimum": 5000, "maximum": 60000 },
        "subtitleMode": { "enum": ["hard", "sidecar", "none"] }
      }
    },
    "resourceEstimate": { "enum": ["low", "medium", "high"] }
  }
}
